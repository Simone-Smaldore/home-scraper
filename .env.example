# Copy to backend/.env for local development. Never commit the real file.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Use the POOLED host: it is the same endpoint with "-pooler" glued to the
# endpoint id, right before the first dot.
#
#   ep-cool-darkness-12345.eu-central-1.aws.neon.tech          <- direct
#   ep-cool-darkness-12345-pooler.eu-central-1.aws.neon.tech   <- pooled
#
# Neon's dashboard does not always offer this as a visible choice; if the string
# you copied has no "-pooler", just add it by hand and leave everything else
# untouched. The API runs as a serverless function, so pooling belongs to
# pgbouncer rather than to the process.
#
# Keep ?sslmode=require — Neon refuses plaintext connections.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Gemini — used by the scraper only, never by the API on Vercel
# ---------------------------------------------------------------------------
# A free AI Studio key (aistudio.google.com). Leave it empty and the scraper
# still runs: listings are collected and filtered, evaluation is skipped, and
# the run says so.
GEMINI_API_KEY=
# The cascade, in order. A daily-quota 429 on one model moves the rest of the
# run to the next; every evaluation records which model produced it.
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemma-3-27b-it
